{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "controle-horas",
  "compatibility_date": "2026-07-21",
  "main": "src/worker.js",
  "vars": {
    "API_ORIGIN": "http://api.example.com"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
