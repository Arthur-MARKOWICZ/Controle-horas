{
  "expo": {
    "name": "Controle de Horas",
    "slug": "controle-horas",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "controlehoras",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.controlehoras.app"
    },
    "android": {
      "package": "com.controlehoras.app",
      "splash": {
        "image": "./assets/android-splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#03112B"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Controle de Horas use o Face ID para entrar mais rápido."
        }
      ],
      "expo-document-picker",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dcc82360-a8fd-4022-a1ec-edd1f6edbddf"
      }
    }
  }
}
