DATABASE_URL=postgres://postgres:postgres@localhost:5432/controle_horas
DB_POOL_MAX=5
JWT_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_32_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_WITH_A_DIFFERENT_32_BYTE_SECRET
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=10
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
TIME_ZONE=America/Sao_Paulo
PORT=8080
NODE_ENV=development
OPENAPI_ENABLED=true
LOG_LEVEL=info
# Obrigatórias para o fluxo "Esqueceu a senha" por e-mail.
# Exemplo: smtp://usuario:senha@smtp.exemplo.com:587
SMTP_URL=
SMTP_FROM="Controle de Horas <no-reply@exemplo.com>"
PUBLIC_APP_URL=http://localhost:5173
