{
  "name": "controle-horas-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --enable-source-maps --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "migrate": "node --enable-source-maps dist/database/migrate.js",
    "migrate:dev": "tsx src/database/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcryptjs": "^3.0.2",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "oxlint": "^1.27.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
